# Copy to .env and fill in. Never commit .env.
# Leave UI_PASSWORD empty if a proxy in front already handles login.
UI_USER=admin
UI_PASSWORD=

# Reload nginx automatically after a save that passes `nginx -t`.
NGINX_AUTO_RELOAD=true
# Backups kept per file.
NGINX_AUTOHANDLER_BACKUP_KEEP=4

# Cloudflare: token needs Zone:Read and DNS:Edit on the zones you use. Leave empty to turn DNS off.
CLOUDFLARE_API_TOKEN=
# Extra hostnames to keep pointing at this host (the UI also stores its own list).
CLOUDFLARE_DOMAINS=
# Keep tracked records pointed at this host's public IP on a timer.
CLOUDFLARE_IP_SYNC=true
# Create A records for server_name entries when a config is saved.
CLOUDFLARE_DNS_FROM_CONFIGS=true
CLOUDFLARE_PROXIED=false
CLOUDFLARE_CHECK_INTERVAL_SECONDS=600

# Optional Discord webhook for save, reject and rollback messages.
DISCORD_WEBHOOK_URL=
