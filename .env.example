# Copy to .env. Never commit .env.
#
# Every value below is optional. Anything set here (non-empty) is locked in the
# Settings dialog and wins over values saved from the UI. Leave a line empty to
# manage that setting from the UI instead. The names used by obsoletelabs/cloudflare_updater
# and obsoletelabs/nginx-reloading (for example NOTIFIER_SMTP_SERVER) work as well.

# Login for the editor. Leave UI_PASSWORD empty if a proxy in front handles login.
UI_USER=admin
UI_PASSWORD=

# Extra hostnames to keep pointed at this host, comma separated (the UI keeps its own list too).
CLOUDFLARE_DOMAINS=

# Container behaviour. UI_BIND=127.0.0.1 keeps the editor off the network. AUTOHANDLER_DISABLED=true runs plain nginx.
# NGINX_EXIT_ON_FAILURE=true exits when nginx does (stock behaviour) instead of retrying so the editor can fix the config.
TZ=
UI_BIND=
AUTOHANDLER_DISABLED=
NGINX_EXIT_ON_FAILURE=
NGINX_LOG_ROTATE_BYTES=

# ---- Cloudflare
# API token
CLOUDFLARE_API_TOKEN=
# Proxy new records (orange cloud) (default: false)
CLOUDFLARE_PROXIED=
# Keep records on this host's public IP (default: true)
CLOUDFLARE_IP_SYNC=
# When the IP changes, move every A record that pointed at the old IP (default: true)
CLOUDFLARE_MOVE_OLD_IP_RECORDS=
# Create A records for server_name on save (default: true)
CLOUDFLARE_DNS_FROM_CONFIGS=
# IP check interval (seconds) (default: 600)
CLOUDFLARE_CHECK_INTERVAL_SECONDS=
# Retry delay when no whoami URL answers (seconds) (default: 10)
RETRY_INTERVAL_SECONDS=

# ---- Public IP lookup
# Whoami URLs, comma separated, tried in order
WHOAMI_URLS=
# Do not add the obsoletelabs whoami servers as fallbacks (default: false)
OVERRIDE_OBSOLETE_WHOAMI=
# Drop whoami URLs whose host does not resolve (default: false)
ENFORCE_DNS_RESOLUTION=
# Test each whoami URL at startup (default: true)
TEST_URL_CONNECTIVITY=
# Drop whoami URLs that cannot be reached (default: false)
ENFORCE_URL_CONNECTIVITY=
# Drop whoami URLs that do not answer with an IP (default: false)
ENFORCE_URL_VALIDITY=
# Wait this long and ask again before acting on a changed IP (0 acts at once) (default: 5)
IP_CHANGE_CONFIRM_SECONDS=
# Starting IP for testing (skips detecting it on first run)
INITIAL_IP=

# ---- Certificates
# Let's Encrypt contact email
ACME_EMAIL=
# Certificate authority (ACME) (default: letsencrypt)
ACME_PROVIDER=
# Custom ACME directory URL (when the authority is custom)
ACME_DIRECTORY_URL=
# External account binding key id (ZeroSSL, Google)
ACME_EAB_KID=
# External account binding HMAC key
ACME_EAB_HMAC_KEY=
# DNS provider for the DNS-01 challenge (default: cloudflare)
ACME_DNS_PROVIDER=
# Use the staging service (test certificates) (default: true)
ACME_STAGING=
# Folders of certificates you bind-mount, comma separated (listed read-only) (default: /certs)
EXTERNAL_CERT_DIRS=
# Renew Let's Encrypt/ACME certificates this many days before they expire (checked every 12 hours) (default: 30)
CERT_RENEW_DAYS=
# Warn this many days before a certificate expires (0 turns warnings off) (default: 14)
CERT_EXPIRY_WARN_DAYS=

# ---- Git sync
# Repository URL (https://github.com/you/nginx-config.git). Leave empty to turn git sync off
GIT_REPO_URL=
# Branch (default: main)
GIT_BRANCH=
# Folder inside the repository that holds the nginx config (empty = the top)
GIT_SUBDIR=
# Access token (a GitHub token with Contents access to the repository)
GIT_TOKEN=
# What to sync (default: pull)
GIT_MODE=
# Sync automatically every this many minutes (0 = only when you press the button) (default: 0)
GIT_INTERVAL_MINUTES=
# When a file changed both here and in the repository (default: keep-local)
GIT_CONFLICTS=
# Name on commits made here (default: nginx-autohandler)
GIT_AUTHOR_NAME=
# Email on commits made here
GIT_AUTHOR_EMAIL=

# ---- Email (SMTP)
# Send email notifications (default: true)
SMTP_ENABLED=
# Host
SMTP_HOST=
# Security (default: starttls)
SMTP_SECURITY=
# Name in the server certificate (set it when the host above is an IP address)
SMTP_TLS_SERVER_NAME=
# Check the server certificate (default: true)
SMTP_VERIFY_TLS=
# Port (0 uses the default for the security mode) (default: 0)
SMTP_PORT=
# Username
SMTP_USERNAME=
# Password
SMTP_PASSWORD=
# From address
SMTP_FROM=
# Recipients (comma separated)
SMTP_TO=
# Reply-To address
SMTP_REPLY_TO=
# List-Unsubscribe header
SMTP_UNSUBSCRIBE=
# Precedence header (default: bulk)
SMTP_PRECEDENCE=
# Send attempts (default: 3)
SMTP_RETRIES=
# Seconds between attempts (default: 1.5)
SMTP_RETRY_DELAY=

# ---- Discord
# Webhook URL (several allowed, comma separated)
DISCORD_WEBHOOK_URL=
# Name shown on messages (default: nginx autohandler)
DISCORD_USERNAME=
# Ping appended to IP change messages (for example @here)
DISCORD_PING=
# Bold IP change messages (default: false)
DISCORD_BOLD=
# Heading level for IP change messages (0 to 3) (default: 0)
DISCORD_PREFIX_HEADER=
# Send config changes as embeds (default: true)
USE_EMBEDS=

# ---- Nginx
# Reload nginx after a valid change (default: true)
NGINX_AUTO_RELOAD=
# Watch the config folder for edits made outside this page (default: true)
WATCH_CONFIG=
# Include a diff in change reports (default: true)
SEND_DIFF=
# Lines of context around each change (default: 3)
DIFF_CONTEXT=
# Name this host in change reports (default: true)
INCLUDE_HOSTNAME=
# Host name to show instead of the machine's
CUSTOM_HOSTNAME=
# Backups kept per file (default: 4)
NGINX_AUTOHANDLER_BACKUP_KEEP=

# ---- General
# Name used in emails and messages (default: Obsoletelabs Nginx Autohandler)
SERVICE_NAME=
# No welcome email on first start (default: false)
DISABLE_WELCOME_EMAIL=
# No email when the service restarts (default: false)
DISABLE_RESTART_EMAIL=
# Times in emails and notices (local uses the container's TZ setting) (default: both)
TIME_DISPLAY=
# Log level (applies at start) (default: info)
LOG_LEVEL=
# Log file size before it is rotated (default: 50000000)
MAX_LOG_BYTES=
# Colour the console log (default: true)
ENABLE_COLORED_LOGGING=
