# Copy to .env. Never commit .env.
#
# Every value below is optional. Anything set here (non-empty) is locked in the
# Settings dialog and wins over values saved from the UI. Leave a line empty to
# manage that setting from the UI instead.

# Login for the editor. Leave empty if a proxy in front handles login.
UI_USER=admin
UI_PASSWORD=

# Cloudflare: API token with Zone:Read and DNS:Edit on the zones you use.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_DOMAINS=
CLOUDFLARE_PROXIED=
CLOUDFLARE_IP_SYNC=
CLOUDFLARE_DNS_FROM_CONFIGS=
CLOUDFLARE_CHECK_INTERVAL_SECONDS=

# Let's Encrypt (DNS-01 via Cloudflare). Staging is the default.
ACME_EMAIL=
ACME_STAGING=

# Email notifications over SMTP. SECURITY is none, starttls or ssl.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Discord notifications. Both channels fire when both are set.
DISCORD_WEBHOOK_URL=

# Nginx behaviour.
NGINX_AUTO_RELOAD=
NGINX_AUTOHANDLER_BACKUP_KEEP=
